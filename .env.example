# --- Доступ к ЛК ВАТС Ростелеком ---
PBX_BASE_URL=https://p2.cloudpbx.rt.ru

# Учётные данные «Ростелеком Паспорта» (вход /auth/login).
# Их можно не хранить здесь, а передавать в теле запроса /auth/login.
PBX_USERNAME=lk_XXXXXXXXXXXXX
PBX_PASSWORD=change-me

# Домен ВАТС. Нужен только для классического входа (/auth/start) — у SSO-доменов не используется.
PBX_DOMAIN=000000.00.rt.ru

# У части площадок РТК в цепочке self-signed сертификат — тогда false.
PBX_VERIFY_SSL=true

# --- Ключ доступа к ЭТОМУ API (заголовок X-API-Key) ---
# Сгенерировать: openssl rand -hex 32
API_KEY=change-me-long-random

# --- Браузерный вход (только для /auth/login; требует playwright) ---
# Показывать окно браузера (отладка): false = headless
BROWSER_HEADLESS=true
# Своя строка User-Agent, если нужна
BROWSER_USER_AGENT=
# Сколько секунд ждать смены экрана «Ростелеком Паспорта»
BROWSER_STEP_TIMEOUT=90
# Сколько держать открытой страницу ввода SMS-кода
BROWSER_CODE_TTL=300

# --- Прочее ---
# Куда складывать сессию ВАТС (токены)
DATA_DIR=./data
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8010
